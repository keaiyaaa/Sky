<?xml version="1.0" encoding="utf-8"?>
<!--
    航点列表项
    对应 HTML: #waypointList 中的航点条目
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#B3FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvWaypointLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/waypoint_sample_label"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <!-- 区域标签（禁飞/限高/安全） -->
        <TextView
            android:id="@+id/tvZoneBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="8sp"
            android:visibility="gone"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvWaypointCoord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waypoint_sample_coord"
            android:textSize="9sp"
            android:textColor="#999999" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
