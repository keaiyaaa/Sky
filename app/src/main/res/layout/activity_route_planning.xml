<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="match_parent" android:background="#F0F2F5">
    <com.mapbox.mapboxsdk.maps.MapView android:id="@+id/mapView" android:layout_width="0dp"
        android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <LinearLayout android:id="@+id/routeHeader" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="#F2FFFFFF" android:padding="8dp" android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous" android:contentDescription="返回首页" android:background="@android:color/transparent" />
            <TextView android:id="@+id/tvCurrentPosition" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="航线规划" android:textSize="16sp" android:textStyle="bold" android:textColor="#222222" />
            <TextView android:id="@+id/tvCurrentCoord" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:paddingStart="12dp" android:paddingEnd="8dp" android:textSize="12sp" android:textColor="#333333" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="示例区域 · 非飞行许可"
                android:textSize="12sp" android:textColor="#984C00" />
        </LinearLayout>
        <TextView android:id="@+id/tvObstacleStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="本地模拟未运行" android:textColor="#204C78" android:textSize="12sp" android:maxLines="3" />
    </LinearLayout>
    <LinearLayout android:id="@+id/routeMapNotice" android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#EFFFFFFF" android:elevation="6dp" android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/routeHeader" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tvRouteMapStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:padding="6dp" android:text="底图加载中；可用坐标添加和列表编辑航点" android:textSize="12sp" android:textColor="#444444" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRetryMap" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="40dp" android:text="重试底图" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/sidebarPanel" android:layout_width="290dp" android:layout_height="0dp"
        android:orientation="vertical" android:background="#F2FFFFFF" android:padding="8dp" android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/routeMapNotice" app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRouteTabs" android:layout_width="match_parent" android:layout_height="76dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnNewRoute" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="新建航线" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEditRoute" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="编辑航线" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="点击航点编辑坐标、高度或删除"
            android:textSize="11sp" android:textColor="#555555" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvWaypointList" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnOptimize" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="本地优化" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnUndoOptimization" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="撤销优化" android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSyncToMission" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="40dp" android:text="生成航线文件（不上传）" android:textSize="12sp" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/bottomBar" android:layout_width="0dp" android:layout_height="wrap_content"
        android:background="#F2FFFFFF" android:elevation="10dp" android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="4dp">
            <ImageButton android:id="@+id/btnToggleSidebar" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_sort_by_size" android:contentDescription="显示或隐藏航线列表" android:background="@android:color/transparent" />
            <ImageButton android:id="@+id/btnAddPoint" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@android:drawable/ic_input_add" android:contentDescription="关闭地图加点" android:background="@android:color/transparent" />
            <ImageButton android:id="@+id/btnErasePoint" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_delete" android:contentDescription="删除最后一个航点" android:background="@android:color/transparent" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCoordinatePoint" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="44dp" android:text="坐标添加" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCancel" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="44dp" android:text="清空航点" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAction"
                android:layout_width="wrap_content" android:layout_height="44dp" android:text="开始本地模拟" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPauseMission" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="44dp" android:text="暂停模拟" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMissionHistory" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="44dp" android:text="执行记录" android:textSize="12sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDeviceMission" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="44dp" android:text="真机执行" android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
