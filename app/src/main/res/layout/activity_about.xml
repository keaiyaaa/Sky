<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="@color/gray_50">

    <!-- 顶部栏 -->
    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:title="@string/about_system"
            app:titleTextColor="@color/gray_800"
            app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

            <!-- Logo -->
            <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_logo"
                    android:gravity="center">

                <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_logo" />
            </LinearLayout>

            <!-- 应用名称 -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/app_version"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/version_code"
                    android:textSize="12sp"
                    android:textColor="@color/gray_500"
                    android:layout_marginTop="4dp" />

            <!-- 分隔线 -->
            <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="24dp"
                    android:background="@color/gray_200" />

            <!-- 设备信息 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_info"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_800"
                            android:layout_marginBottom="12dp" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                        <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/software_version"
                                android:textSize="11sp"
                                android:textColor="@color/gray_500" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="v1.0.0"
                                android:textSize="11sp"
                                android:textColor="@color/gray_800" />
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                        <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/drone_model"
                                android:textSize="11sp"
                                android:textColor="@color/gray_500" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Mavic 4 Pro v2"
                                android:textSize="11sp"
                                android:textColor="@color/gray_800" />
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                        <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/serial_number"
                                android:textSize="11sp"
                                android:textColor="@color/gray_500" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="SN: TS-2026-001"
                                android:textSize="11sp"
                                android:textColor="@color/gray_800" />
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/firmware_version"
                                android:textSize="11sp"
                                android:textColor="@color/gray_500" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="FW 03.02.0100"
                                android:textSize="11sp"
                                android:textColor="@color/gray_800" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 保修信息 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/warranty_info"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_800"
                            android:layout_marginBottom="12dp" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">

                        <TextView
                                android:layout_width="100dp"
                                android:layout_height="wrap_content"
                                android:text="@string/warranty_status"
                                android:textSize="11sp"
                                android:textColor="@color/gray_500" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="2027-04-12"
                                android:textSize="11sp"
                                android:textColor="@color/green_500" />
                    </LinearLayout>

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:text="购买 Care+ 可延长保修期至 2 年，享受优先技术支持"
                            android:textSize="10sp"
                            android:textColor="@color/blue_700"
                            android:background="@drawable/bg_blue_light" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 存储信息 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/storage_info"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_800"
                            android:layout_marginBottom="12dp" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp"
                                android:background="@drawable/bg_card_gray">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/video_count"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_500" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="247"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_800" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="个文件"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_400" />
                        </LinearLayout>

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:layout_marginStart="12dp"
                                android:padding="12dp"
                                android:background="@drawable/bg_card_gray">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/image_count"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_500" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1,832"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_800" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="张照片"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_400" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/total_capacity"
                                android:textSize="11sp"
                                android:textColor="@color/gray_500" />

                        <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="512 GB"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_800" />
                    </LinearLayout>

                    <ProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:progress="75"
                            android:progressTint="@color/primary" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/used_capacity"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_400" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="384 GB"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_800" />
                        </LinearLayout>

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="end">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/available_capacity"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_400" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="128 GB"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/green_500" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 底部按钮 -->
            <Button
                    android:id="@+id/btn_user_manual"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/user_manual"
                    android:textSize="12sp"
                    android:background="@drawable/bg_card_white"
                    android:textColor="@color/gray_700" />

            <Button
                    android:id="@+id/btn_check_update"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="32dp"
                    android:text="@string/check_update"
                    android:textSize="12sp"
                    android:background="@drawable/bg_card_white"
                    android:textColor="@color/gray_700" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>