<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="horizontal"
              android:background="@color/white">

    <!-- ══════════ 左侧品牌面板 ══════════ -->
    <LinearLayout
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/bg_login_left">

        <LinearLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_drone_icon"
                android:elevation="6dp">

            <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_drone"
                    android:contentDescription="无人机图标" />
        </LinearLayout>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="创建账号"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="加入天枢巡检系统\n开启智能巡检之旅"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="V2.4.0"
                android:textSize="9sp"
                android:textColor="#99FFFFFF"
                android:letterSpacing="0.1"
                android:background="@drawable/bg_version_pill" />
    </LinearLayout>

    <!-- ══════════ 右侧注册面板 ══════════ -->
    <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="36dp"
                android:paddingVertical="16dp">

            <!-- 标题 -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="注册新账号"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_800" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="填写以下信息完成注册"
                    android:textSize="11sp"
                    android:textColor="@color/gray_500" />

            <!-- 用户名 -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="用户名"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_700" />

            <EditText
                    android:id="@+id/et_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="请输入用户名"
                    android:inputType="text"
                    android:maxLength="20"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/bg_input_field" />

            <!-- 手机号 -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="手机号"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_700" />

            <EditText
                    android:id="@+id/et_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="请输入手机号"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/bg_input_field" />

            <!-- 验证码 -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="验证码"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_700" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                <EditText
                        android:id="@+id/et_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="请输入验证码"
                        android:inputType="number"
                        android:maxLength="6"
                        android:textSize="13sp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp"
                        android:background="@drawable/bg_input_field" />

                <TextView
                        android:id="@+id/btn_get_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="9dp"
                        android:text="获取验证码"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/brand_green"
                        android:background="@drawable/bg_code_btn"
                        android:clickable="true"
                        android:focusable="true" />
            </LinearLayout>

            <!-- 密码 -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="密码"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_700" />

            <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="请设置密码（6-20位）"
                    android:inputType="textPassword"
                    android:maxLength="20"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/bg_input_field" />

            <!-- 确认密码 -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="确认密码"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_700" />

            <EditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="请再次输入密码"
                    android:inputType="textPassword"
                    android:maxLength="20"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:background="@drawable/bg_input_field" />

            <!-- 用户协议 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                <CheckBox
                        android:id="@+id/cb_agreement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                <TextView
                        android:id="@+id/tv_agreement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="我已阅读并同意 用户协议 和 隐私政策"
                        android:textSize="11sp"
                        android:textColor="@color/gray_600"
                        android:clickable="true"
                        android:focusable="true" />
            </LinearLayout>

            <!-- 注册按钮 -->
            <TextView
                    android:id="@+id/btn_register"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:paddingVertical="11dp"
                    android:text="注  册"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_login_btn"
                    android:elevation="3dp"
                    android:clickable="true"
                    android:focusable="true" />

            <!-- 登录链接 -->
            <TextView
                    android:id="@+id/tv_go_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_gravity="center_horizontal"
                    android:text="已有账号？ 立即登录"
                    android:textSize="12sp"
                    android:textColor="@color/gray_600"
                    android:clickable="true"
                    android:focusable="true" />

            <!-- 返回设置页 -->
            <TextView
                    android:id="@+id/tv_back_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp"
                    android:layout_gravity="center_horizontal"
                    android:text="← 返回设置页"
                    android:textSize="10sp"
                    android:textColor="@color/gray_400"
                    android:clickable="true"
                    android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
