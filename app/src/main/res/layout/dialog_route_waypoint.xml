<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="使用 WGS84 经纬度；高度为相对起点高度，范围 0 至 500 米。区域仅为示例规则。" android:textSize="13sp" />
        <EditText android:id="@+id/etWaypointLatitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="纬度（-90 至 90）" android:inputType="numberDecimal|numberSigned" android:maxLength="24" android:singleLine="true" />
        <EditText android:id="@+id/etWaypointLongitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="经度（-180 至 180）" android:inputType="numberDecimal|numberSigned" android:maxLength="24" android:singleLine="true" />
        <EditText android:id="@+id/etWaypointAltitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="高度（米）" android:inputType="numberDecimal|numberSigned" android:maxLength="12" android:singleLine="true" />
    </LinearLayout>
</ScrollView>
