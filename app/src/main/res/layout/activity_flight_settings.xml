<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="@color/gray_50">

    <!-- 顶部栏 -->
    <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:title="@string/flight_parameters"
            app:titleTextColor="@color/gray_800"
            app:navigationIcon="@drawable/ic_arrow_back" />

    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:clipToPadding="false">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/tv_settings_migration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/gray_700"
                    android:layout_marginBottom="12dp" />
            <!-- 返航高度 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                        <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_altitude"
                                android:tint="@color/primary" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_return_altitude"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_800" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_return_altitude_desc"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_500" />
                        </LinearLayout>

                        <TextView
                                android:id="@+id/tv_altitude_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100.00m"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary" />
                    </LinearLayout>

                    <EditText
                            android:id="@+id/et_return_altitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:inputType="numberDecimal"
                            android:maxLength="12"
                            android:singleLine="true"
                            android:hint="返航高度（米，最多两位小数，留空为未设置）" />
                    <SeekBar
                            android:id="@+id/sb_altitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:max="380"
                            android:progress="80"
                            android:progressDrawable="@drawable/slider_progress"
                            android:thumb="@drawable/slider_thumb" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="20m"
                                android:textSize="9sp"
                                android:textColor="@color/gray_400" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="210m"
                                android:textSize="9sp"
                                android:textColor="@color/gray_400"
                                android:gravity="center" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="400m"
                                android:textSize="9sp"
                                android:textColor="@color/gray_400"
                                android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 失控行为 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                        <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_warning"
                                android:tint="@color/red_500" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_failsafe"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_800" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_failsafe_desc"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_500" />
                        </LinearLayout>
                    </LinearLayout>

                    <RadioGroup
                            android:id="@+id/rg_failsafe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        <RadioButton
                                android:id="@+id/rb_failsafe_rth"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="自动返航"
                                android:textSize="11sp"
                                android:checked="true" />

                        <RadioButton
                                android:id="@+id/rb_failsafe_hover"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="悬停"
                                android:textSize="11sp" />

                        <RadioButton
                                android:id="@+id/rb_failsafe_land"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="原地降落"
                                android:textSize="11sp" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 新手模式 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                        <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_school"
                                android:tint="@color/green_500" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_beginner"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_800" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_beginner_desc"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_500" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switch_beginner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/tv_beginner_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:padding="12dp"
                            android:text="本地返航高度选项已限制为30m；设备限制仍需下发确认与真机验证"
                            android:textSize="10sp"
                            android:textColor="@color/green_700"
                            android:background="@drawable/bg_green_light"
                            android:visibility="gone" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 避障行为 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                        <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_shield"
                                android:tint="@color/orange_500" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_obstacle"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_800" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_obstacle_desc"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_500" />
                        </LinearLayout>
                    </LinearLayout>

                    <RadioGroup
                            android:id="@+id/rg_obstacle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                        <RadioButton
                                android:id="@+id/rb_obstacle_brake"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="刹停"
                                android:textSize="11sp"
                                android:checked="true" />

                        <RadioButton
                                android:id="@+id/rb_obstacle_bypass"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="绕行"
                                android:textSize="11sp" />
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 操控灵敏度 -->
            <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                        <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_sensitivity"
                                android:tint="@color/purple_500" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_sensitivity"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_800" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/flight_sensitivity_desc"
                                    android:textSize="9sp"
                                    android:textColor="@color/gray_500" />
                        </LinearLayout>

                        <TextView
                                android:id="@+id/tv_sensitivity_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5 档（1–10）"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/purple_500" />
                    </LinearLayout>

                    <SeekBar
                            android:id="@+id/sb_sensitivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:max="9"
                            android:progress="4"
                            android:progressDrawable="@drawable/slider_progress_purple"
                            android:thumb="@drawable/slider_thumb_purple" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <CheckBox
                    android:id="@+id/cb_sensitivity_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="已重新选择或确认当前灵敏度（1–10档）"
                    android:visibility="gone" />
            <!-- 保存按钮 -->
            <TextView
                    android:id="@+id/tv_sync_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="当前显示本地设置，设备尚未确认。连接后请点击保存并同步。"
                    android:textColor="@color/gray_700"
                    android:textSize="13sp" />
            <Button
                    android:id="@+id/btn_save"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="32dp"
                    android:text="@string/save_settings"
                    android:textSize="13sp"
                    android:background="@drawable/bg_primary_rounded"
                    android:textColor="@color/white" />

            <include layout="@layout/view_account_settings" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
