<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".HomeActivity">

    <!-- 主内容 -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/background">

        <!-- 顶部栏 -->
        <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingStart="24dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:background="#F5F6F8"
                android:contentInsetStart="0dp"
                android:contentInsetEnd="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetEnd="0dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                <ImageView
                        android:id="@+id/btn_navigation"
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:padding="12dp"
                        android:src="@drawable/ic_menu"
                        android:contentDescription="打开侧边菜单"
                        android:clickable="true"
                        android:focusable="true" />

                <TextClock
                        android:id="@+id/tv_current_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="HH:mm"
                        android:format24Hour="HH:mm"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/gray_800" />

                <LinearLayout
                        android:id="@+id/ll_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_location">

                    <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_location" />

                    <TextView
                            android:id="@+id/tv_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="位置未接入"
                            android:textSize="10sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginStart="4dp" />
                </LinearLayout>

                <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_wifi" />

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginStart="10dp">

                    <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_battery" />

                    <TextView
                            android:id="@+id/tv_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--%"
                            android:textSize="10sp"
                            android:textColor="@color/gray_700"
                            android:layout_marginStart="2dp" />
                </LinearLayout>

                <Button
                        android:id="@+id/btn_vip"
                        android:layout_width="44dp"
                        android:layout_height="22dp"
                        android:text="VIP"
                        android:textSize="9sp"
                        android:background="@drawable/bg_vip"
                        android:textColor="@color/white"
                        android:layout_marginStart="10dp" />

                <ImageView
                        android:id="@+id/btn_menu"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_settings_gear"
                        android:padding="4dp"
                        android:layout_marginStart="6dp" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- 主内容区 - 三列布局 -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="12dp">

            <!-- 左侧：设备状态（隐藏入口：连续点击 5 次打开 SDK 测试面板） -->
            <LinearLayout
                    android:id="@+id/ll_device_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true">

                <TextView
                        android:id="@+id/tv_device_card_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/drone_status"
                        android:textSize="9sp"
                        android:textColor="@color/gray_500"
                        android:letterSpacing="0.1" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                    <TextView
                            android:id="@+id/tv_device_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未连接设备"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_800" />

                    <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                    <FrameLayout
                            android:id="@+id/tv_switch_device"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_switch_device"
                            android:clickable="true"
                            android:focusable="true">

                        <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_swap_horizontal"
                                android:clickable="false"
                                android:focusable="false" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                        android:id="@+id/tv_device_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="等待设备连接"
                        android:textSize="9sp"
                        android:textColor="@color/primary"
                        android:layout_marginBottom="12dp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="机载存储"
                        android:textSize="9sp"
                        android:textColor="@color/gray_500" />

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical">

                    <ProgressBar
                            android:id="@+id/progress_storage"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_weight="1"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:visibility="gone"
                            android:progressTint="@color/primary" />

                    <TextView
                            android:id="@+id/tv_storage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="暂无设备数据"
                            android:textSize="9sp"
                            android:textColor="@color/gray_500"
                            android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- 任务入口 -->
                <LinearLayout
                        android:id="@+id/ll_mission_entry"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card_gray"
                        android:clickable="true"
                        android:focusable="true">

                    <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_mission" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mission_center"
                            android:textSize="11sp"
                            android:textColor="@color/gray_700"
                            android:layout_marginTop="6dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- 中间：视频区 -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="8dp">

                <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/white">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                        <!-- 任务标题栏 -->
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="14dp">

                            <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="航拍预览"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/gray_400"
                                    android:letterSpacing="0.15" />

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:gravity="center"
                                    android:text="演示画面"
                                    android:textSize="8sp"
                                    android:textColor="@color/blue_700"
                                    android:background="@drawable/bg_primary_light"
                                    android:paddingHorizontal="10dp" />
                        </LinearLayout>

                        <!-- 视频区 -->
                        <androidx.cardview.widget.CardView
                                android:id="@+id/card_video"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="2"
                                android:layout_marginHorizontal="8dp"
                                app:cardCornerRadius="8dp"
                                app:cardBackgroundColor="@color/black"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                            <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent">

                                <ImageView
                                        android:id="@+id/video_preview"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/can" />

                                <!-- 首页航拍演示视频：存在 test.mp4 时替代静态预览图（can.jpg），等比居中 -->
                                <VideoView
                                        android:id="@+id/video_preview_video"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:background="#000000"
                                        android:visibility="gone" />

                                <!-- OSD面板 -->
                                <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_margin="8dp"
                                        android:orientation="horizontal"
                                        android:background="@color/black_50"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="4dp">

                                    <TextView
                                            android:id="@+id/tv_osd_height"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="H:--m"
                                            android:textSize="8sp"
                                            android:textColor="@color/white"
                                            android:layout_marginEnd="8dp" />

                                    <TextView
                                            android:id="@+id/tv_osd_distance"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="D:--m"
                                            android:textSize="8sp"
                                            android:textColor="@color/white"
                                            android:layout_marginEnd="8dp" />

                                    <TextView
                                            android:id="@+id/tv_osd_speed"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="SPD:--m/s"
                                            android:textSize="8sp"
                                            android:textColor="@color/white" />
                                </LinearLayout>

                                <!-- 录制指示器 -->
                                <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="top|center_horizontal"
                                        android:layout_marginTop="8dp"
                                        android:orientation="horizontal"
                                        android:background="#E53935"
                                        android:paddingHorizontal="6dp"
                                        android:paddingVertical="2dp">

                                    <View
                                            android:layout_width="5dp"
                                            android:layout_height="5dp"
                                            android:background="@drawable/bg_red_circle" />

                                    <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="示例"
                                            android:textSize="7sp"
                                            android:textColor="@color/white"
                                            android:layout_marginStart="3dp" />
                                </LinearLayout>

                                <TextView
                                        android:id="@+id/tv_telemetry_source"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="bottom|start"
                                        android:layout_margin="8dp"
                                        android:padding="6dp"
                                        android:background="@color/black_70"
                                        android:text="未连接 · 无飞行数据"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                <!-- 全屏按钮 -->
                                <ImageView
                                        android:id="@+id/btn_fullscreen"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="top|end"
                                        android:layout_margin="8dp"
                                        android:src="@drawable/ic_fullscreen"
                                        android:background="@color/black_50"
                                        android:padding="4dp" />
                            </FrameLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- 任务进度信息 -->
                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:paddingTop="8dp"
                                android:paddingBottom="12dp">

                            <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                <TextView
                                        android:id="@+id/tv_progress"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="45%"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/gray_800" />

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="进度"
                                        android:textSize="8sp"
                                        android:textColor="@color/gray_500" />
                            </LinearLayout>

                            <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                <TextView
                                        android:id="@+id/tv_completed_waypoints"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="8"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/gray_800" />

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="已完成航点"
                                        android:textSize="8sp"
                                        android:textColor="@color/gray_500" />
                            </LinearLayout>

                            <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                <TextView
                                        android:id="@+id/tv_defect_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="2"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/red_500" />

                                <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="疑似缺陷"
                                        android:textSize="8sp"
                                        android:textColor="@color/gray_500" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- 右侧：快捷入口 -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <!-- 开始飞行 -->
                <androidx.cardview.widget.CardView
                        android:id="@+id/card_start_flight"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:background="@drawable/bg_flight_gradient">

                        <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_flight_white"
                                android:layout_marginTop="4dp" />

                        <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/start_flight"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/manual_control"
                                android:textSize="10sp"
                                android:textColor="#CCFFFFFF"
                                android:layout_marginTop="2dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 规划航线 -->
                <androidx.cardview.widget.CardView
                        android:id="@+id/card_route_plan"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/white"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="12dp">

                        <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_route" />

                        <View
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/route_plan"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/gray_800" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auto_task"
                                android:textSize="9sp"
                                android:textColor="@color/gray_500" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 左侧抽屉菜单 -->
    <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            app:menu="@menu/navigation_menu"
            app:headerLayout="@layout/nav_header" />

</androidx.drawerlayout.widget.DrawerLayout>
