# Copy this file to .env and fill values on the deployment host. Never commit .env.
AERIAL_BIND_ADDRESS=127.0.0.1
AERIAL_PORT=8080
AERIAL_API_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
# Workspace-specific Qwen3-ASR-Flash OpenAI-compatible endpoint.
# Example shape: https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_BASE_URL=
BAILIAN_ASR_MODEL=qwen3-asr-flash
